# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/ecommerce

# JWT Secrets
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Email Configuration (Optional - for notifications)
# If not configured, emails will be skipped silently
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=E-Commerce Store
ADMIN_EMAIL=admin@example.com

# Support Contact Info (shown in emails)
SUPPORT_EMAIL=support@yourstore.com
SUPPORT_PHONE=+92 300 1234567
SUPPORT_WHATSAPP=+92 300 1234567
FRONTEND_URL=http://localhost:3000

# Admin Account (for initial setup)
ADMIN_EMAIL_DEFAULT=admin@sanixhub.com
ADMIN_PASSWORD_DEFAULT=Admin@123
